generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Single Daraz seller-center connection for this app instance. Enforced as a
// singleton (id is always "singleton") since this is a personal tool, not a
// multi-tenant installable app - there's exactly one Daraz account to manage.
model DarazAccount {
  id                    String   @id @default("singleton")
  country               String
  sellerId              String?
  accessTokenEnc        String
  refreshTokenEnc       String
  tokenExpiresAt        DateTime
  refreshTokenExpiresAt DateTime
  connectedAt           DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

enum SyncStatus {
  unmapped
  pending
  synced
  error
}

// This app's own product catalog - the source of truth is here, not Shopify.
// A product is created/edited directly in this app, then mapped to a Daraz
// category + attributes before it can be synced (created/updated) on Daraz.
model Product {
  id             String     @id @default(cuid())
  title          String
  descriptionHtml String?
  vendor         String?
  imagesJson     String     @default("[]") // JSON array of image URLs

  darazCategoryId String?
  attributesJson   String?   // JSON object of Daraz attribute name -> value
  darazItemId      String?
  darazSkuId       String?
  syncStatus       SyncStatus @default(unmapped)
  lastSyncedAt     DateTime?
  lastError        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants ProductVariant[]

  @@index([syncStatus])
}

model ProductVariant {
  id              String   @id @default(cuid())
  productId       String
  sku             String
  price           String
  compareAtPrice  String?
  quantity        Int      @default(0)
  packageWeightKg Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, sku])
}

// Daraz orders mirrored into our own DB for viewing - read-only, nothing is
// pushed anywhere else from here.
model DarazOrder {
  id             String    @id @default(cuid())
  darazOrderId   String    @unique
  orderNumber    String?
  customerName   String?
  status         String
  itemsCount     Int       @default(0)
  totalAmount    String?
  currency       String?
  darazCreatedAt DateTime?
  darazUpdatedAt DateTime?
  importedAt     DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  items DarazOrderItem[]

  @@index([darazCreatedAt])
}

model DarazOrderItem {
  id               String  @id @default(cuid())
  orderId          String
  darazOrderItemId String
  sku              String?
  name             String?
  imageUrl         String?
  price            String?
  currency         String?
  status           String?

  order DarazOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}
