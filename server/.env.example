# Firebase Admin SDK credentials for Firestore. From Firebase Console ->
# Project settings -> Service accounts -> Generate new private key. Paste
# client_email and private_key from that downloaded JSON here (keep the
# \n sequences in private_key literal - they're converted to real newlines
# at runtime).
FIREBASE_PROJECT_ID="daraz-sync"
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Daraz Open Platform app credentials (from open.daraz.com)
DARAZ_APP_KEY=""
DARAZ_APP_SECRET=""
# Must match a redirect URI registered for your Daraz app, pointing at this
# server's callback route.
DARAZ_REDIRECT_URI="http://localhost:3001/api/daraz/callback"

# 32-byte key, base64-encoded (generate with: openssl rand -base64 32)
# Encrypts Daraz OAuth tokens at rest.
ENCRYPTION_KEY=""

# Any random long string - signs the OAuth `state` param (generate with:
# openssl rand -hex 32).
STATE_SECRET=""

# Signs the login session cookie (generate with: openssl rand -hex 32).
SESSION_SECRET=""

# Authenticates Vercel Cron's calls to /api/cron/sync (generate with:
# openssl rand -hex 32). Set the same value as the Vercel project's
# CRON_SECRET env var - Vercel sends it automatically as
# `Authorization: Bearer <value>` on scheduled cron requests.
CRON_SECRET=""

# Single-user login for this app's own UI.
APP_USERNAME="admin"
APP_PASSWORD="change-me"

PORT=3001
# Origin the Vite dev server runs on, for CORS + cookie settings in dev.
CLIENT_URL="http://localhost:5173"
NODE_ENV="development"
