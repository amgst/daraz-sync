rules_version = '2';

// All reads/writes for this app go through the Express server via the
// Firebase Admin SDK (server/src/db.ts), which always bypasses these rules.
// These rules only govern direct client-side access using the public web
// config - and there is no legitimate client-side access, since the app's
// own login (APP_USERNAME/APP_PASSWORD) gates everything at the API layer.
// So: deny everyone, unconditionally.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
